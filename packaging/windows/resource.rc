// Windows resource script: app icon + application manifest + full VERSIONINFO.
// Compiled with mingw's windres into a .syso that `go build` links automatically.

1 ICON "packaging/icons/icon.ico"
1 24 "packaging/windows/app.manifest" // 24 = RT_MANIFEST, id 1 = app manifest

1 VERSIONINFO
FILEVERSION 1,4,1,0
PRODUCTVERSION 1,4,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Luan Freitas"
      VALUE "FileDescription", "Generates .cov cover files for Super Nintendo ROMs (sd2snes)"
      VALUE "FileVersion", "1.4.1.0"
      VALUE "InternalName", "sd2snes-covers"
      VALUE "LegalCopyright", "(C) 2026 Luan Freitas"
      VALUE "OriginalFilename", "sd2snes-covers.exe"
      VALUE "ProductName", "sd2snes Covers"
      VALUE "ProductVersion", "1.4.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
